{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Realtime backend: one Durable Object per note, reached over WebSocket at
  // live.noteful.me. The Vue app is a separate Cloudflare Pages project (noteful).
  "name": "notewith-me",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "NoteRoom", "class_name": "NoteRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NoteRoom"] }],
  "routes": [{ "pattern": "live.noteful.me", "custom_domain": true }],
  // Keep notewith-me.mehmetfirataksoy.workers.dev on: builds made before live.noteful.me still connect there.
  "workers_dev": true,
  // Notes written before the realtime editor (copied from MongoDB once with
  // scripts/export-legacy-notes.cjs). A room imports its old note from here.
  "d1_databases": [
    { "binding": "LEGACY_DB", "database_name": "noteful-legacy", "database_id": "ef1cad4e-51a0-4100-aefc-40620ee3edf8", "migrations_dir": "migrations" }
  ],
  // Images, encrypted in the browser with a key that lives only in the note.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "noteful-images" }],
  // Uploads per visitor (IP) per minute; worker/index.js adds an hourly cap.
  "ratelimits": [{ "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }],
  "vars": {
    // Comma-separated origins allowed besides the built-in list in worker/index.js.
    "EXTRA_ORIGINS": "",
    // Ceiling for all images together; uploads stop past it.
    "IMAGE_STORAGE_GB": "5"
  }
}
